---
layout: null
---
{"schema_version":1,"id":{{ '/#person' | absolute_url | jsonify }},"url":{{ '/' | absolute_url | jsonify }},"updated":{{ site.data.profile.updated | jsonify }},"name":{{ site.data.profile.name | jsonify }},"headline":{{ site.data.profile.headline | jsonify }},"description":{{ site.data.profile.intro | jsonify }},"personal":{{ site.data.profile.about | jsonify }},"experience":[{% for event in site.events %}{"id":{{ event.title | slugify | prepend: 'history-' | jsonify }},"title":{{ event.title | jsonify }},"period":{{ event.date | jsonify }},"description":{{ event.description | jsonify }}}{% unless forloop.last %},{% endunless %}{% endfor %}],"writing":[{% for post in site.posts %}{% assign text_url = post.url | prepend: '/text' | append: '.md' %}{"id":{{ post.url | absolute_url | jsonify }},"title":{{ post.title | jsonify }},"url":{{ post.url | absolute_url | jsonify }},"markdown_url":{{ text_url | absolute_url | jsonify }},"published":{{ post.date | date_to_xmlschema | jsonify }},"updated":{{ post.lastmod | default: post.date | date_to_xmlschema | jsonify }}}{% unless forloop.last %},{% endunless %}{% endfor %}]}

<% h = ->(value) { CGI.escapeHTML(value.to_s) }; latest = posts.first; mvp = posts.find { |p| p[:slug] == 'lessons-mvp-launch' }; robotics = posts.find { |p| p[:slug] == 'IROS' }; article = current[:post]; title = article ? article[:title] : current[:type] == 'history' ? 'Experience' : variant[:name] -%>
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="robots" content="noindex,nofollow"><title><%= h.call(title) %> / Mario Mendez</title><meta name="description" content="<%= h.call(variant[:subtitle]) %>"><link rel="stylesheet" href="../assets/styles.css"><link rel="describedby" href="../llms.txt"><link rel="alternate" type="application/json" href="../profile.json" title="Prototype professional record"><% if article %><link rel="alternate" type="text/markdown" href="../text/<%= article[:slug] %>.md" title="Article Markdown"><% end %><script src="../assets/interactions.js" defer></script><% if variant[:motif] %><link rel="stylesheet" href="../assets/personal.css"><script src="../assets/personal.js" defer></script><% end %><% if variant[:scroll] %><link rel="stylesheet" href="../assets/scroll.css"><script src="../assets/scroll.js" defer></script><% end %><% if variant[:pair] %><link rel="stylesheet" href="../assets/pairings.css"><% unless variant[:minimal] %><script src="../assets/pairings.js" defer></script><% end %><% end %><% if variant[:minimal] %><link rel="stylesheet" href="../assets/quiet.css"><% unless variant[:mountain] %><script src="../assets/quiet.js" defer></script><% end %><% end %><% if variant[:mountain] %><link rel="stylesheet" href="../assets/mountains.css"><script src="../assets/mountains.js" defer></script><% end %></head>
<body class="<%= variant[:id] %><%= " personal personal-#{variant[:motif]}" if variant[:motif] %><%= " scroll-option scroll-#{variant[:scroll]}" if variant[:scroll] %><%= " paired-study pair-#{variant[:pair]}" if variant[:pair] %><%= " quiet-study quiet-#{variant[:minimal]}" if variant[:minimal] %><%= " mountain-study mountain-#{variant[:mountain]}" if variant[:mountain] %>"><a class="skip" href="#main">Skip to content</a><div class="wrap"><header class="site-head"><a class="brand" href="index.html">Mario Mendez</a><nav class="nav" aria-label="Main"><a href="index.html"<%= ' aria-current="page"' if current[:type]=='home' %>>Writing</a><a href="history.html"<%= ' aria-current="page"' if current[:type]=='history' %>>Experience</a><a class="agent-nav" href="../agents/index.html"><%= variant[:pair] ? "Agent version" : "For agents" %></a><a href="mailto:mmendezdiaz@outlook.com">Email</a></nav><% if variant[:pair] && current[:type]=='home' %><div class="paired-header" aria-hidden="true"><%= File.read("design-review/art/#{variant[:pair]}-header.svg") %></div><% end %></header>
<main id="main">
<% if current[:type] == 'home' -%>
<section class="intro"><div><% if variant[:minimal]=='incline' %><div class="intro-identity"><img class="portrait-photo intro-portrait" src="../../img/kakto.jpg" alt="Mario Mendez" width="72" height="86"><% end %><h1><%= variant[:motif]=='summit' ? 'I like trying things I’m not quite ready for.' : h.call(variant[:tagline]) %></h1><% if variant[:minimal]=='incline' %></div><% end %><% if variant[:motif]=='summit' %><p>I’m Mario, a CTO and founder. I build software, run marathons, and head out on multi-day bike trips. I like the part where something that felt out of reach starts to feel possible.</p><% else %><p><%= h.call(variant[:description]) %></p><% end %><% if variant[:id]=='journal' %><div class="intro-links"><a href="history.html">About my work</a><a href="https://github.com/mario-evo">GitHub</a></div><% end %></div><% if variant[:id]=='record' %><p class="index-note"><span class="label">At Evotrux</span><br>Building freight software.<br>Learning to build a team<br>I’d want to be part of.<br><a href="history.html">Experience</a></p><% end %><% if variant[:pair] %><div class="paired-scene<%= ' portrait-scene' if variant[:minimal]=='cairn' %>" data-pair="<%= variant[:pair] %>"<%= " data-mountain=\"#{variant[:mountain]}\"" if variant[:mountain] %><%= " data-quiet=\"#{variant[:minimal]}\"" if variant[:minimal] %>><% if variant[:minimal]=='cairn' %><img class="portrait-photo lead-portrait" src="../../img/kakto.jpg" alt="Mario Mendez" width="136" height="160"><% end %><%= File.read("design-review/art/#{variant[:pair]}-main.svg") %></div><% elsif variant[:motif] %><%= ERB.new(File.read('design-review/templates/personal-scene.erb'), trim_mode:'-', eoutvar:'_scene_output').result(binding) %><% end %></section>
<% unless variant[:pair] %><a class="mobile-agent-link" href="../agents/index.html">For your agent: profile, history &amp; writing</a><% end %>
<div class="columns"><section aria-labelledby="writing-title">
<% if variant[:id]=='journal' -%>
<div class="heading-row"><h2 id="writing-title">Recent writing</h2><a href="#archive">Older posts</a></div>
<% posts.first(2).each do |post| -%><article class="post"><div class="meta"><time datetime="<%= post[:iso] %>"><%= post[:date] %></time></div><h3><a href="<%= post[:slug] %>.html"><%= h.call(post[:title]) %></a></h3><p><%= h.call(post[:summary]) %></p></article><% end -%>
<div class="heading-row" id="archive" style="margin-top:32px"><h2>Older posts</h2></div><% posts.drop(2).each do |post| -%><article class="post"><time class="meta" datetime="<%= post[:iso] %>"><%= post[:date] %></time><h3><a href="<%= post[:slug] %>.html"><%= h.call(post[:title]) %></a></h3></article><% end -%>
<% elsif variant[:id]=='fieldguide' -%>
<div class="heading-row"><h2 id="writing-title">Browse by topic</h2></div><div class="filters" data-filter-group aria-label="Filter writing by subject"><% [['all','Everything'],['systems','Systems'],['product','Product'],['teams','Teams'],['experiments','Experiments']].each do |key,label| %><button type="button" data-topic="<%= key %>" aria-pressed="<%= key=='all' %>"><%= label %></button><% end %></div><p class="filter-count" data-filter-count aria-live="polite">8 published entries</p><div data-filter-items><% posts.each do |post| -%><article class="post" data-topics="<%= post[:topics] %>"><time class="meta" datetime="<%= post[:iso] %>"><%= post[:date] %></time><h3><a href="<%= post[:slug] %>.html"><%= h.call(post[:title]) %></a></h3><p><%= h.call(post[:summary]) %></p></article><% end -%></div>
<% else -%>
<div class="heading-row"><h2 id="writing-title">Work and related posts</h2><a href="history.html">Full history</a></div>
<% [[latest,'Evotrux / seed round'],[mvp,'Evotrux / MVP launch'],[robotics,'University of Manitoba / robotics']].each do |post,context| -%><article class="chapter"><span class="year"><%= post[:year] %></span><div><div class="meta"><%= context %></div><h3><a href="<%= post[:slug] %>.html"><%= h.call(post[:title]) %></a></h3><p><%= h.call(post[:summary]) %></p></div></article><% end -%>
<div class="heading-row" style="margin-top:32px"><h2>More writing</h2></div><% posts.reject { |p| [latest,mvp,robotics].include?(p) }.each do |post| -%><article class="post"><time class="meta" datetime="<%= post[:iso] %>"><%= post[:date] %></time><h3><a href="<%= post[:slug] %>.html"><%= h.call(post[:title]) %></a></h3></article><% end -%>
<% end -%>
</section><aside class="side" aria-label="About Mario"><% if variant[:minimal]=='sisyphus' %><figure class="sidebar-portrait"><img class="portrait-photo" src="../../img/kakto.jpg" alt="Mario Mendez" width="112" height="132"><figcaption>Mario Mendez</figcaption></figure><% end %>
<% unless variant[:pair] %><section class="agent-panel"><span class="file-mark">For you + your agent</span><h2>Send your agent here.</h2><p>Looking me up with an agent? I’ve made a plain-text profile, my work history, and my writing available for it to read.</p><a class="agent-link" href="../agents/index.html">Get the agent briefing</a><div class="agent-formats"><a href="../profile.md">Markdown</a><a href="../profile.json">JSON</a></div></section><% end %>
<section><h2><%= variant[:motif]=='summit' ? 'Away from the keyboard' : 'A bit about me' %></h2><% if variant[:motif]=='summit' %><p>I’ve run several marathons and taken multi-day bike trips. I like mountains, cats, and finding out I can go a little further than I thought.</p><% else %><p>I like the technical work. I also care about how a team communicates, how a product gets used, and whether we’re solving the right problem.</p><% end %><a href="history.html">Experience</a></section>
<% if variant[:id]=='fieldguide' -%><section><h2>From the posts</h2><blockquote style="margin:0;color:var(--ink)">“Every new feature was its own mini mvp.”</blockquote><p style="margin-top:13px">We were a three-person team. We had to get better at deciding what not to build.</p><a href="<%= latest[:slug] %>.html">Road to Seed Round</a></section><% else -%><section><h2>Where I’ve worked</h2><ul class="roles"><li><strong>Evotrux</strong><span>2022–present</span></li><li><strong>AGCO / 151 Research</strong><span>2020–2022</span></li><li><strong>Robotics &amp; research</strong><span>2018–2019</span></li></ul></section><% end -%>
<section><h2>Get in touch</h2><a href="mailto:mmendezdiaz@outlook.com">Email</a><br><a href="https://www.linkedin.com/in/mario-mendez-d/">LinkedIn</a><br><a href="https://github.com/mario-evo">GitHub</a></section>
</aside></div>
<% elsif current[:type]=='history' -%>
<section class="intro history-intro"><h1>Experience</h1><p>I’ve worked on freight software, full-stack systems, cloud infrastructure, IoT, and humanoid robots. Here’s the history, with links to what I wrote along the way.</p></section><div class="history-list"><div class="principle"><p>“Also learning how to build the team I’d want to be part of.”</p><span class="meta">From my Evotrux timeline entry</span></div><% events.each_with_index do |event,index| -%><article class="history-event"><div><div class="meta"><%= h.call(event[:date]) %></div><img src="<%= h.call(event[:image]) %>" alt="" loading="lazy"></div><div><h2><%= h.call(event[:title]) %></h2><p><%= h.call(event[:description]) %></p><% if index==0 %><a href="<%= latest[:slug] %>.html">Road to Seed Round</a><% elsif index==1 %><a href="<%= mvp[:slug] %>.html"><%= h.call(mvp[:title]) %></a><% elsif index==6 %><a href="<%= robotics[:slug] %>.html"><%= h.call(robotics[:title]) %></a><% end %></div></article><% end -%></div>
<% else -%>
<div class="article-layout"><aside class="article-aside"><a href="index.html">All writing</a><div class="label">Published</div><time datetime="<%= article[:iso] %>"><%= article[:date] %></time><div class="label">Reading time</div><span><%= (article[:words]/220.0).ceil %> minutes</span><div class="toc"><div class="label">Also available</div><a href="../text/<%= article[:slug] %>.md">Markdown</a><a href="../agents/index.html">Agent briefing</a><a href="history.html">Experience</a></div></aside><article><header class="article-head"><p class="eyebrow"><%= article[:topics].split.join(' / ') %></p><h1><%= h.call(article[:title]) %></h1><p class="dek"><%= h.call(article[:summary]) %></p></header><div class="prose"><%= article[:body] %></div><div class="principle" style="margin-top:35px"><a href="index.html">More writing</a></div></article></div>
<% end -%>
</main><footer class="foot"><span>Mario Mendez</span><div><a href="https://mariomendez.me/feed.xml">RSS</a><a class="agent-footer" href="../agents/index.html"><%= variant[:pair] ? "Agent version" : "For agents" %></a><a href="https://github.com/mario-evo">GitHub</a></div></footer><div class="review-strip"><span>Local preview / <%= variant[:name] %></span><a href="<%= variant[:mountain] ? "../mountains.html" : variant[:minimal] ? "../quiet.html" : variant[:pair] ? "../pairings.html" : variant[:scroll] ? "../motion.html" : variant[:motif] ? "../personal.html" : "../index.html" %>">Compare layouts</a></div></div></body></html>

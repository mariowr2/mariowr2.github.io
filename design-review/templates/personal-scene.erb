<% if variant[:motif]=='cat' -%>
<div class="personal-scene cat-scene" data-cat data-awake="false">
<svg viewBox="0 0 300 180" role="img" aria-labelledby="scene-title"><title id="scene-title">A cat napping beside a window looking onto mountains</title><defs><clipPath id="window-cut"><rect x="142" y="13" width="127" height="100" rx="1"/></clipPath></defs>
<g class="scene-quiet" fill="none" stroke="currentColor" stroke-width="1.2"><rect x="140" y="11" width="131" height="104" rx="2"/><path d="M205 11V115M140 63H271"/><g clip-path="url(#window-cut)"><path d="M137 100L175 51L204 90L229 43L280 105M174 52L184 78L194 76M229 44L240 75L250 70"/><path d="M140 108Q185 91 217 109T276 109"/></g><path d="M25 133H278M21 138H280"/></g>
<g class="cat-body" transform="translate(57 75)" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M18 41C7 26 9 13 22 8L19-15L38-5Q47-8 57-4L71-14L70 12Q84 17 85 36C95 35 104 41 103 49C102 61 71 59 65 56H23Q8 57 7 48Q6 43 18 41Z"/><path d="M26 43Q37 39 41 49M56 45Q66 41 72 49M33 52H47M63 52H75"/><path class="cat-tail" d="M78 52C104 57 124 54 123 43C122 32 109 35 111 42" fill="none"/>
<g class="cat-sleep-eyes" stroke="var(--accent)"><path d="M27 12Q32 17 38 12M51 12Q57 17 62 11"/></g><g class="cat-open-eyes" fill="var(--accent)" stroke="none"><ellipse cx="33" cy="12" rx="4.8" ry="5.5"/><ellipse cx="56" cy="12" rx="4.8" ry="5.5"/><g class="cat-pupils" fill="var(--paper)"><ellipse cx="33" cy="12" rx="1.7" ry="3.5"/><ellipse cx="56" cy="12" rx="1.7" ry="3.5"/></g></g><path d="M42 20L47 20L45 23ZM45 23V27M30 23L13 20M29 28L12 30M59 23L77 20M60 28L78 30" stroke-width="1"/></g>
<g class="scene-quiet" fill="none" stroke="currentColor" stroke-width="1.2" transform="translate(224 134) scale(.75)"><circle cx="-13" cy="21" r="12"/><circle cx="26" cy="21" r="12"/><path d="M-13 21L0-2L11 21ZM0-2H18L26 21M11 21L18-2L15-9H23M-5-4H6"/></g></svg>
<button class="scene-control" type="button" data-cat-toggle aria-pressed="false">Wake the cat</button></div>
<% elsif variant[:motif]=='ride' || variant[:motif]=='notebook' -%>
<div class="personal-scene ride-scene" data-route>
<svg viewBox="0 0 320 180" role="img" aria-labelledby="scene-title"><title id="scene-title">A bicycle on an illustrated route through the mountains</title><g class="scene-quiet" fill="none" stroke="currentColor" stroke-width="1.15"><path d="M12 107L66 39L104 81L144 17L209 87L248 44L304 110M66 39L73 65L83 61M144 17L141 53L158 44L171 60M248 44L251 68L263 61"/><path d="M10 143Q55 129 83 149T153 140T231 145T309 129M10 157Q60 145 95 162T173 152T245 158T310 144"/></g><path id="scenic-path" d="M25 131C61 112 77 143 109 119S153 124 180 95S230 109 287 66" fill="none" stroke="var(--line)" stroke-width="2"/><path class="route-travelled" d="M25 131C61 112 77 143 109 119S153 124 180 95S230 109 287 66" fill="none" stroke="var(--accent)" stroke-width="1.7" stroke-linecap="round"/>
<g class="rider-marker" transform="translate(107 120) rotate(-12)" fill="var(--paper)" stroke="var(--accent)" stroke-width="1.35" stroke-linecap="round" stroke-linejoin="round"><circle cx="-12" cy="-7" r="8"/><circle cx="13" cy="-7" r="8"/><path d="M-12-7L-3-22L2-7ZM-3-22H8L13-7M2-7L8-22L6-26H13M-7-24H1M-1-32L-6-24L4-19L1-8M-1-32L9-28L10-24" fill="none"/><circle cx="3" cy="-38" r="3"/><path d="M-1-40Q3-45 7-39" fill="none"/></g><circle cx="25" cy="131" r="2" fill="var(--muted)"/><circle cx="287" cy="66" r="2.5" fill="var(--accent)"/>
<% if variant[:motif]=='notebook' -%><g transform="translate(257 142)" class="small-cat" stroke="var(--muted)" fill="var(--paper)" stroke-width="1.3"><path d="M0 4L-2-6L5-2L11-6L12 4Q20 12 13 17H1Q-6 10 0 4ZM13 16Q29 19 26 7"/><path d="M1 5H3M8 5H10"/></g><% end -%>
</svg><div class="route-control"><label for="route-position">Move the rider</label><input id="route-position" type="range" min="0" max="100" value="31" aria-label="Move the rider along the illustrated route"></div></div>
<% else -%>
<div class="personal-scene summit-scene" <%= variant[:scroll] ? 'data-scroll-mountain' : 'data-summit data-step="0"' %>><svg viewBox="0 0 320 190" role="img" aria-labelledby="scene-title"><title id="scene-title">A mountain, contour lines, and a hiker making their way up a winding trail</title>
<g fill="none" class="scene-quiet" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round"><path d="M14 139L49 113L78 122L142 24L173 70L192 47L305 148M142 24L141 56L153 49L164 81M192 47L193 69L204 64"/><path d="M15 148Q48 123 77 136T127 113T183 102T235 122T305 158M15 157Q55 133 82 146T136 123T191 114T247 136T304 169M27 166Q65 148 92 156T145 136T201 130T255 151T295 178M42 174Q78 160 109 166T158 150T213 147T262 168M71 181Q100 173 128 176T171 163T225 162M102 186Q129 183 152 182T186 176T226 177"/></g>
<path id="summit-path" class="summit-route" d="M25 146Q70 115 98 127T141 107Q118 95 151 88T168 71L151 62L142 27" fill="none" stroke="var(--muted)" stroke-width="1.2" stroke-dasharray="2 5"/><path class="summit-travelled" d="M25 146Q70 115 98 127T141 107Q118 95 151 88T168 71L151 62L142 27" fill="none" stroke="var(--accent)" stroke-width="1.6"/>
<g class="hiker-marker" transform="translate(25 146)" stroke="var(--accent)" stroke-width="1.6" stroke-linecap="round" fill="var(--paper)"><circle cx="0" cy="-17" r="2.5"/><path d="M0-13L-2-6L-6 0M-2-6L3-1M-1-12L4-8L7-11M7-12L6 0M-3-12L-6-11L-5-6" fill="none"/></g><path d="M142 23V8L154 13L142 16" fill="none" stroke="var(--accent)" stroke-width="1.2"/></svg><% unless variant[:scroll] %><div class="summit-control"><button class="scene-control" type="button" data-summit-step>Take another step</button><span class="scene-status" data-summit-status aria-live="polite">At the trailhead</span></div><% end %></div>
<% end -%>
